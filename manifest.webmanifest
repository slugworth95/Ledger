{
  "name": "Ledger — portable notes",
  "short_name": "Ledger",
  "description": "Notes that leave as one self-contained file any browser can read.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#E9E9E3",
  "theme_color": "#22262B",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/html": [".html", ".htm"],
        "text/markdown": [".md"],
        "text/plain": [".txt"],
        "application/json": [".json"]
      }
    }
  ],
  "shortcuts": [
    { "name": "New note", "url": "./index.html?new=1" }
  ]
}
